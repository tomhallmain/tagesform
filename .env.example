# Flask settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secure-secret-key-here

# Database settings
DATABASE_URL=sqlite:///tagesform.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# UI Colors
FOREGROUND_COLOR=white
BACKGROUND_COLOR=#2596BE

# Debug mode
DEBUG=False

# Server settings
SERVER_PORT=6000
SERVER_HOST=localhost
SERVER_PASSWORD=

# OpenWeather settings
OPEN_WEATHER_API_KEY=your_api_key_here
OPEN_WEATHER_CITY=Washington

# News API settings
NEWS_API_KEY=your_news_api_key_here
BBC_NEWS_TRUST=0.5

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
TASK_UPDATE_INTERVAL=24

# Context window (tokens) requested from Ollama per call -- without this,
# Ollama falls back to the model's own default, which can be too small for
# a large prompt (e.g. the planning agent's task_overview signal, listing
# hundreds of tasks) to actually fit. Raise this (and check your model
# supports it, and your host has the VRAM/RAM for it) if the model seems
# to be missing tasks it was actually sent -- see TASK_OVERVIEW_MAX_PER_GROUP.
OLLAMA_NUM_CTX=8192

# How often (in hours) the event cache (holidays/religious calendars) is
# refreshed from the live upstream APIs
EVENT_CACHE_UPDATE_INTERVAL=24

# How often (in hours) computed/deterministic calendar sources (Hebrew,
# Coptic) get backfilled -- effectively a no-op most runs, see config.py
COMPUTED_CALENDAR_BACKFILL_INTERVAL=24

# How often (in hours) the suggestion queue is recomputed per user
SUGGESTION_QUEUE_REFRESH_INTERVAL=6

# Mustermeister (external task manager) integration -- see
# docs/task-email-integration.md. Token is minted on the Mustermeister
# side (session-authenticated /profile page), not something this app
# generates. Left blank, the integration is a no-op.
MUSTERMEISTER_BASE_URL=
MUSTERMEISTER_API_TOKEN=
MUSTERMEISTER_POLL_INTERVAL=3
MUSTERMEISTER_TASK_LIMIT=500

# BriefKorb (external email client) integration -- see
# docs/task-email-integration.md. Token/label pair is hand-added to
# BriefKorb's own email_server/config.yaml, not something this app
# generates. Left blank, the integration is a no-op.
BRIEFKORB_BASE_URL=
BRIEFKORB_API_TOKEN=
BRIEFKORB_POLL_INTERVAL=6

# The single Tagesform user id that Mustermeister/BriefKorb-derived
# suggestion queue candidates surface for -- see
# docs/task-email-integration.md. Left blank, those candidates are
# disabled for every user regardless of the settings above.
TASK_EMAIL_INTEGRATION_USER_ID=

# Enables the LLM-driven planning agent (app/services/planning_agent_service.py)
# -- joins calendar/weather/task/email candidates into synthesized
# suggestion queue entries via extensions/llm.py. Off by default: unlike
# the other candidate sources, this makes a real LLM call per signal per
# user on every suggestion queue refresh.
PLANNING_AGENT_ENABLED=False

# How many tasks the planning agent's task_overview signal lists under
# each priority group in its LLM prompt -- a display cap, not a filter (a
# group's true count is always stated even when the listed tasks are
# capped below it). Defaults to the same ceiling as MUSTERMEISTER_TASK_LIMIT
# so nothing that was actually fetched gets left out just because it
# landed in a large priority group -- lower this only if prompt size/
# latency becomes a real problem.
TASK_OVERVIEW_MAX_PER_GROUP=500
